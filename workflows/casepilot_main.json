    {
      "id": "f2bf6005-baa2-52ca-a98a-cff2a8e66cc2",
      "name": "Turn Pipeline Contract",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        740,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const r=$json; const b=r.body;\nif(r.statusCode>=200 && r.statusCode<300) {\n  if(!b || !b.proposal || !b.proposal.id || !b.proposal.hash) throw new Error('Missing scoped proposal');\n  if(b.method==='final') {\n    if(b.architecture!=='v2' || !Array.isArray(b.pipeline) || b.model_calls>8 || b.repair_count>1) throw new Error('Invalid bounded pipeline result');\n    if(b.quality_revision!=='v2.2-quality') throw new Error('Unsupported quality contract');\n    if(!b.validation_error && (!b.judge || b.judge.verdict!=='accept')) throw new Error('Unchecked draft rejected');\n    if(!b.validation_error && b.mode==='live' && (!b.reviewed_draft || b.judge.draft_version!==b.reviewed_draft.draft_version)) throw new Error('Stale draft review');\n    if(b.validation_error && (b.decision!=='escalate' || b.summary.sources.length)) throw new Error('Unsafe fallback rejected');\n    if(b.decision==='escalate' && (!b.summary.handoff || !b.summary.handoff.maintainer_action)) throw new Error('Missing actionable handoff');\n    if(b.validation_error==='judge_contract_error' && !b.review_failures.some(x=>x.kind==='judge_contract')) throw new Error('Missing contract failure trace');\n  }\n}\nreturn [{json:r}];"
      }
    }
