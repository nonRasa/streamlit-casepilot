# Copy values into environment; this file is NOT automatically loaded.
CASEPILOT_MODE=replay
METIS_API_KEY=
METIS_BASE_URL=https://api.metisai.ir/openai/v1
METIS_MODEL=
# Set actual gateway USD rates per million tokens; live refuses absent rates.
CASEPILOT_INPUT_USD_PER_MILLION=
CASEPILOT_OUTPUT_USD_PER_MILLION=
# Conservative operational ceiling; total course budget must never exceed $5.
CASEPILOT_BUDGET_USD=0.50
CASEPILOT_MAX_OUTPUT_TOKENS=1600
# V2: rates include the gateway markup; verify current provider prices.
METIS_EMBEDDING_MODEL=text-embedding-3-small
CASEPILOT_EMBEDDING_USD_PER_MILLION=
# Optional separate judge model; its own rates are mandatory when different.
# METIS_JUDGE_MODEL=
# CASEPILOT_JUDGE_INPUT_USD_PER_MILLION=
# CASEPILOT_JUDGE_OUTPUT_USD_PER_MILLION=
# Per-turn hard limits in pipeline.py: 8 invocations, $0.04, 180 seconds.
# Build all embeddings explicitly once; the turn path embeds only the query.
CASEPILOT_API_TOKEN=
CASEPILOT_REVIEW_TOKEN=
# Shared team ledger: keep one persistent copy; do not reset between experiments.
# CASEPILOT_BUDGET_DB=/absolute/persistent/team_budget.sqlite3
